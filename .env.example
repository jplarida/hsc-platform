# Copy to .env. Development values only — .env is gitignored.

# Docker Compose stack (npm run db:up). Port 5433, not 5432: a native PostgreSQL
# install may already hold 5432, and pointing the test suite at the wrong server is
# a confusing way to lose an afternoon.
DATABASE_URL="postgresql://hsc_owner:hsc_dev_password@localhost:5433/hsc_dev?schema=public"

# performance/01: cache and state are separate instances with different eviction
# policies. volatile-lru may drop entries under pressure; noeviction must not, because
# it holds rate-limiter windows, idempotency keys and circuit-breaker state.
REDIS_CACHE_URL="redis://localhost:6379"
REDIS_STATE_URL="redis://localhost:6381"

# Access token signing. Minimum 32 bytes, enforced at startup.
#
# HS256 with a shared secret is a DEVELOPMENT arrangement. Production uses asymmetric
# keys held in KMS (infrastructure/06) so the API can verify tokens without ever
# holding material capable of minting one. Do not carry this pattern forward.
JWT_SECRET="dev-only-secret-at-least-32-bytes!!"

# Bounded by the connection budget in database/08, not by expected load: the ceiling
# is what PgBouncer and RDS can carry.
DB_POOL_MAX="10"

PORT="3001"

# Only used by `npm run db:create:native`, the alternative to the container stack.
# PGSUPERPASS="your-postgres-superuser-password"
PGHOST="localhost"
PGPORT="5433"

# CORS allowlist. Comma-separated. A leading "*." matches subdomains on the dot boundary,
# so "*.tenants.example.com" admits acme.tenants.example.com but not
# evil-tenants.example.com. There is deliberately no wildcard-everything option:
# Access-Control-Allow-Origin: * cannot carry credentials, and reflecting any origin
# alongside Allow-Credentials is a standing CSRF invitation.
CORS_ALLOWED_ORIGINS="http://localhost:5173"

# Pre-authentication flood control, before any token is examined. Deliberately generous —
# the real quota is the per-tenant and per-user limit at stage 9, which knows the plan.
# Tight here would break shared egress: a hospital behind one NAT is many legitimate users
# on one address and they must not throttle each other.
IP_RATE_LIMIT_PER_MINUTE="300"
