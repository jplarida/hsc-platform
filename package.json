{
  "name": "hsc-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Health, Safety & Compliance Platform — database schema",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:nuke": "docker compose down -v && docker compose up -d",
    "db:migrate": "prisma migrate deploy",
    "db:pull": "node scripts/db-pull.mjs",
    "db:generate": "prisma generate",
    "lint:migrations": "node scripts/lint-migrations.mjs",
    "test": "node --test --test-concurrency=1 \"tests/*.test.mjs\"",
    "db:create:native": "node scripts/db-create.mjs",
    "db:seed": "node scripts/seed.mjs"
  },
  "devDependencies": {
    "prisma": "^6.1.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "pg": "^8.13.1"
  }
}
