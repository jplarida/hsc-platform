{
  "name": "hsc-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Health, Safety & Compliance Platform — database schema",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:nuke": "docker compose down -v && docker compose up -d",
    "db:migrate": "prisma migrate deploy",
    "db:pull": "node scripts/db-pull.mjs",
    "db:generate": "prisma generate",
    "lint:migrations": "node scripts/lint-migrations.mjs",
    "test": "npm run build && node --test --test-concurrency=1 \"tests/*.test.mjs\"",
    "db:create:native": "node scripts/db-create.mjs",
    "db:seed": "node scripts/seed.mjs",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "prisma": "^6.1.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "jose": "^6.2.10",
    "pg": "^8.13.1",
    "yaml": "^2.9.0"
  }
}
